# Copy to .env (never commit .env). Used by docker compose for the LOCAL stack only.

# Google AI Studio API key (https://aistudio.google.com/apikey). Free tier is enough for the demo.
GEMINI_API_KEY=

# Any Gemini model that supports function calling. Check the current model list in AI Studio.
# The fallback is used automatically when the primary model is overloaded or rate-limited.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Shared secret between the agent and the MCP server (local value; in AWS it is generated into Secrets Manager).
MCP_TOKEN=local-mcp-token-change-me
